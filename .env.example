# Порта на серверот
PORT=3000

# development | docker | production
NODE_ENV=development

# Локална база (се користи секогаш освен кога NODE_ENV=production)
MONGODB_URI=mongodb://127.0.0.1:27017/vrvtura

# Продукциска база (MongoDB Atlas) – се користи автоматски кога NODE_ENV=production
MONGODB_ATLAS_URI=mongodb+srv://KORISNIK:LOZINKA@cluster0.xxxxx.mongodb.net/vrvtura

# Таен клуч за JWT токени (задолжително смени го во продукција)
JWT_SECRET=smeni-me-so-dolg-sluchaen-string
JWT_EXPIRES_IN=7d

# Е-пошта (ако SMTP_HOST е празно, пораките само се печатат во конзолата)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ВрвТура <no-reply@vrvtura.mk>"

# true = root (/) ги служи статичните маски од Дел 1 наместо React апликацијата
SERVE_MOCKUPS=false
